# Copier en .env et adapter
PORT=4000

# Connexion PostgreSQL — option 1 : URL complète
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pharmaco

# Connexion PostgreSQL — option 2 : variables séparées (utilisées si DATABASE_URL absent)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=pharmaco

# Origine autorisée pour le CORS (frontend Vite)
CLIENT_ORIGIN=http://localhost:5173

# SSL pour PostgreSQL :
#   - laisser vide    -> auto (activé si l'URL contient sslmode=require)
#   - PGSSL=true       -> forcer SSL (bases hébergées : Render, Neon, Supabase…)
#   - PGSSL=false      -> désactiver (Postgres local)
PGSSL=
