# Copier en .env et adapter
PORT=4000

# Connexion PostgreSQL — option 1 (production) : URL Supabase, PRIORITAIRE.
# Utiliser l'URL « Session pooler » (compatible IPv4, requise sur Render) :
# Supabase -> Project -> Connect -> Session pooler, ex :
#   postgresql://postgres.<ref>:<mot_de_passe>@aws-0-<region>.pooler.supabase.com:5432/postgres
# SSL activé automatiquement quand cette variable est définie.
SUPABASE_URL=

# Connexion PostgreSQL — option 2 : URL complète (utilisée si SUPABASE_URL absent)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pharmaco

# Connexion PostgreSQL — option 3 : variables séparées (si aucune URL fournie)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=pharmaco

# Origine autorisée pour le CORS (frontend Vite)
CLIENT_ORIGIN=http://localhost:5173

# SSL pour PostgreSQL :
#   - laisser vide    -> auto (activé avec SUPABASE_URL ou si l'URL contient sslmode=require)
#   - PGSSL=true       -> forcer SSL (bases hébergées : Supabase, Neon…)
#   - PGSSL=false      -> désactiver (Postgres local)
PGSSL=

# === Sécurité (OBLIGATOIRE en production) ===
# Secret HMAC qui signe les jetons d'authentification. S'il n'est pas défini,
# un secret de développement (public) est utilisé et les jetons sont
# falsifiables : le serveur REFUSE alors de démarrer en production.
# Générer une valeur robuste (≥ 32 caractères) :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Contournement explicite (déconseillé) : autorise le démarrage en production
# avec un secret faible. À n'utiliser que temporairement.
# ALLOW_INSECURE_AUTH=true

# Migration idempotente du schéma au démarrage (true par défaut).
# RUN_MIGRATIONS=false

# Mot de passe par défaut accepté pour les comptes sans hash (auto-réparation).
# DEFAULT_PASSWORD=pharmaco123
