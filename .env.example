# Variables pour docker-compose (copier en .env). Ne pas committer .env.
# Mot de passe de la base PostgreSQL (conteneur db).
POSTGRES_PASSWORD=change_moi_mot_de_passe_solide

# Secret de signature des jetons (obligatoire). Générer :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=remplacer_par_un_secret_aleatoire

# Origine autorisée pour le CORS. Avec le proxy nginx (même origine), * convient ;
# sinon mettre l'URL publique du frontend, ex : https://pharmaco.mondomaine.fr
CLIENT_ORIGIN=*

# Port exposé du frontend sur l'hôte (http://IP_DU_PI:WEB_PORT).
WEB_PORT=8080
